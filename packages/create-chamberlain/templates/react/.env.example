# dev 中の env-var fallback。keyring を使う代わりに、CHAMBERLAIN_SECRET_<UPPERCASE_NAME>
# を先に読む。値は Chamberlain 上に残らない。
#
# Anthropic API key (秘書チャット + chamberlain.ai.complete 用)
# CHAMBERLAIN_SECRET_ANTHROPIC_API_KEY=sk-ant-...
#
# GitHub personal access token (github-issues-count サンプルトリガー用)
# CHAMBERLAIN_SECRET_GITHUB_TOKEN=ghp_...

# dev mode を有効化 (tick を 10s に、schedule 下限を緩和)
CHAMBERLAIN_DEV=1
